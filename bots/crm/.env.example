# CRM bot — copy to .env and fill in
BOT_TOKEN=
ADMIN_IDS=                      # comma-separated Telegram user ids
ALERT_CHAT_ID=                  # group for alerts
DEADREQ_CHAT_ID=0               # optional: separate chat for dead-requisite alerts
FIN_ALERT_CHAT_ID=0             # optional: separate chat for finance alerts
ACCESS_KEY=                     # master key users send to unlock the bot
PASSWORD_SECRET=                # HMAC secret for stored keys

# Read-only analytics replica (processing DB)
ANALYTICS_DB_URL=postgresql://read_user:password@replica.example.internal:5432/core

# Bot's own CRM storage. Empty = SQLite (DB_PATH)
DATABASE_URL=
DB_PATH=merchants.db

OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

METABASE_URL=https://metabase.example.com
METABASE_EMAIL=
METABASE_PASSWORD=
