# Read-only replica (same as the CRM bot, VPC-only)
ANALYTICS_DB_URL=postgresql://read_user:password@replica.example.internal:5432/core

# Listen on localhost only; access through an SSH tunnel
DASH_HOST=127.0.0.1
DASH_PORT=8077

# passkey / WebAuthn: through an SSH tunnel the browser sees http://localhost:PORT
DASH_RP_ID=localhost
DASH_ORIGIN=http://localhost:8077

# Session signing secret: openssl rand -hex 32
DASH_SESSION_SECRET=
DASH_DB_PATH=dashboard.db
